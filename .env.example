# ==============================================================================
# LEOXUR FINANCIAL TELEMETRY & TRACKER — PRODUCTION ENVIRONMENT SPECIFICATION
# Copy this file to .env before starting the Docker container stack:
#   cp .env.example .env
# ==============================================================================

# 1. Custom Domain & Reverse Proxy Routing
# Replace with your actual domain or subdomain (e.g., tracker.example.com or example.com)
DOMAIN_NAME=tracker.yourdomain.com
ALLOWED_HOSTS=tracker.yourdomain.com,www.tracker.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://tracker.yourdomain.com,https://www.tracker.yourdomain.com

# 2. Django Security & Core Engine
# Generate a cryptographically strong 50+ char key (e.g., openssl rand -base64 36)
SECRET_KEY=production-secret-key-change-this-to-a-very-secure-random-token-here
DJANGO_DEBUG=False

# Gunicorn WSGI Worker Concurrency & Timeout
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# 3. Database Engine (MySQL 8.0 Container)
USE_MYSQL=True
DB_NAME=income_tracker
DB_USER=leoxur_admin
DB_PASSWORD=replace_with_a_secure_mysql_password_123!
DB_ROOT_PASSWORD=replace_with_a_secure_root_password_456!
DB_HOST=db
DB_PORT=3306

# 4. Optional Initial Administrator Superuser
# If specified, the entrypoint script auto-creates this administrator account on initial startup
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ChangeMeAdminSecure2026!
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com

# 5. Let's Encrypt Automated SSL Notifications
ACME_EMAIL=admin@yourdomain.com

# 6. Leoxur AI Intelligence Copilot (Google Gemini API Key)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# 7. Outgoing SMTP Email & Ingoing IMAP Receipt Auto-Sync (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

